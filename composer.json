{
    "name": "tyhpdef/league-uri-impl",
    "description": "Implementation package for tyhpdef/league-uri. Require tyhpdef/league-uri, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.8.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/league-uri-interfaces": "@dev",
                "tyhpdef/psr-http-factory": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/php-ext-gmp": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/league-uri"
        }
    },
    "require": {
        "php": ">=8.2",
        "league/uri": "7.8.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/league-uri-interfaces": "@dev",
        "tyhpdef/psr-http-factory": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/php-ext-gmp": "@dev"
    }
}
